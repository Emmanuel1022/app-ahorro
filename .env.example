# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase.
# Nunca subas .env.local al repositorio (es público).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Solo para pruebas locales de base de datos (PostgreSQL local)
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
